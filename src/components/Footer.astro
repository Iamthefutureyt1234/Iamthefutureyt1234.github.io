---
import { SITE_TITLE } from "../consts";
const today = new Date();
---

<footer>
  <div class="footer-pill">
    <span>&copy; {today.getFullYear()} {SITE_TITLE}</span>
    <span class="dot">•</span>
    <a href="https://t.me/PlaceOfTHEfuture" target="_blank" rel="noopener noreferrer">
      Telegram
    </a>
    <span class="dot">•</span>
    <a href="https://github.com/Iamthefutureyt1234" target="_blank" rel="noopener noreferrer">
      GitHub
    </a>
  </div>
</footer>

<style>
  footer {
    padding: 2rem 1rem 2.5rem;
    text-align: center;
  }

  .footer-pill {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.6rem 1.35rem;
    border-radius: 9999px;
    background: var(--md-surface-low);
    border: 1px solid var(--md-outline-variant);
    color: var(--md-on-surface-variant);
    font-size: 0.88rem;
  }

  .dot {
    color: var(--md-tertiary);
  }
</style>
