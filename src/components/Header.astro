---
import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE } from "../consts";
---

<header class="m3-header-wrap" transition:name="m3-topbar" transition:animate="none">
  <nav class="m3-topbar">
    <div class="brand">
      <button
        id="miku-badge"
        type="button"
        class="brand-pill"
        dir="ltr"
        title="Toggle Concert Overdrive"
        aria-label="Toggle Concert Overdrive"
      >
        01
      </button>
      <a href="/" class="brand-name">{SITE_TITLE}</a>
    </div>

    <div class="nav-pills">
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/blog">Blog</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
    </div>

    <div class="actions">
      <a
        href="https://t.me/PlaceOfTHEfuture"
        target="_blank"
        rel="noopener noreferrer"
        class="icon-btn"
        aria-label="Telegram Channel"
        title="Telegram Channel"
      >
        <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true">
          <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z" />
        </svg>
      </a>

      <button
        id="theme-toggle"
        class="icon-btn"
        type="button"
        aria-label="Toggle Light and Dark Mode"
        title="Switch Theme"
      >
        <svg class="icon-sun" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    // Cleanly detach any old listeners on hot-reload or page swap
    if (typeof window.__mikuCleanup === "function") {
      window.__mikuCleanup();
    }

    const media = window.matchMedia("(prefers-color-scheme: dark)");
    const onMediaChange = (e) => {
      if (!localStorage.getItem("theme")) {
        document.documentElement.dataset.theme = e.matches ? "dark" : "light";
      }
    };
    media.addEventListener("change", onMediaChange);

    if (!window.__mikuLogged) {
      window.__mikuLogged = true;
      console.log(
        "%c  01 // HATSUNE MIKU  %c  The world is mine (and so is this DOM).  \n%cTip: click the 01 badge, click the homepage tag, or type '39' / 'miku' anywhere.",
        "background:#39c5bb;color:#00201e;font-weight:800;padding:4px 8px;border-radius:6px 0 0 6px;",
        "background:#ff6ba8;color:#3e001f;font-weight:700;padding:4px 8px;border-radius:0 6px 6px 0;",
        "color:#39c5bb;font-family:monospace;font-size:12px;"
      );
    }

    function playChime(notes) {
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        notes.forEach((freq, i) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = "triangle";
          osc.frequency.value = freq;
          gain.gain.setValueAtTime(0.001, ctx.currentTime + i * 0.08);
          gain.gain.exponentialRampToValueAtTime(0.06, ctx.currentTime + i * 0.08 + 0.02);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + i * 0.08 + 0.22);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(ctx.currentTime + i * 0.08);
          osc.stop(ctx.currentTime + i * 0.08 + 0.24);
        });
      } catch (_) {}
    }

    let toastTimer;
    function showToast(text) {
      let toast = document.getElementById("miku-toast");
      if (!toast) {
        toast = document.createElement("div");
        toast.id = "miku-toast";
        toast.className = "miku-toast";
        document.body.appendChild(toast);
      }
      toast.textContent = text;
      toast.classList.add("visible");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.remove("visible"), 3000);
    }

    const leekSvg = `<svg viewBox="0 0 32 32" width="24" height="24" aria-hidden="true"><path d="M18 4c3 3 5 7 4 11l-4 4-4-4c-1-4 1-8 4-11z" fill="#39c5bb"/><path d="M14 7c-3 2-5 5-5 9l5 3 2-5z" fill="#20a39a"/><path d="M12 18l-6 9c-1 1.2.4 2.5 1.8 1.5l8.7-6.2z" fill="#e9f7f5"/></svg>`;
    const items = [leekSvg, "<span>39</span>", "<span>♪</span>", "<span>♫</span>", "<span>01</span>"];

    function spawnLeekRain() {
      for (let i = 0; i < 22; i++) {
        const el = document.createElement("div");
        el.className = "miku-particle";
        el.innerHTML = items[Math.floor(Math.random() * items.length)];
        el.style.left = Math.random() * 96 + 2 + "vw";
        el.style.animationDuration = 2.2 + Math.random() * 1.8 + "s";
        el.style.animationDelay = Math.random() * 0.6 + "s";
        document.body.appendChild(el);
        setTimeout(() => el.remove(), 4600);
      }
    }

    const rippleTargets = ".m3-btn, .icon-btn, .m3-chip, .brand-pill, .nav-pills a, .post-card";
    function spawnRipple(target, e) {
      const rect = target.getBoundingClientRect();
      const size = Math.max(rect.width, rect.height);
      const ripple = document.createElement("span");
      ripple.className = "m3-ripple";
      ripple.style.width = ripple.style.height = size + "px";
      ripple.style.left = e.clientX - rect.left - size / 2 + "px";
      ripple.style.top = e.clientY - rect.top - size / 2 + "px";
      target.appendChild(ripple);
      setTimeout(() => ripple.remove(), 650);
    }

    function syncBadgeText() {
      const badge = document.getElementById("miku-badge");
      if (!badge) return;
      const on = document.documentElement.classList.contains("miku-overdrive");
      badge.textContent = on ? "39" : "01";
    }
    syncBadgeText();

    const tagStates = [
      "01 // MIKU EDITION",
      "STATUS // HIDING IN YOUR WI-FI",
      "CV01 // 3939 Hz",
      "WORLD IS MINE // 100%",
      "ITEM // LEEK.EXE LOADED",
    ];
    let tagIdx = 0;

    const onClick = (e) => {
      const target = e.target instanceof Element ? e.target : e.target?.parentElement;
      if (!target) return;

      // 1. Theme toggle
      if (target.closest("#theme-toggle")) {
        const current = document.documentElement.dataset.theme;
        const next = current === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("theme", next);
      }

      // 2. Single-click 01 badge -> Toggle Concert Overdrive (flips 01 <-> 39)
      const badge = target.closest("#miku-badge");
      if (badge) {
        const active = document.documentElement.classList.toggle("miku-overdrive");
        sessionStorage.setItem("miku-overdrive", active ? "on" : "off");
        badge.textContent = active ? "39" : "01";
        if (active) {
          playChime([523.25, 659.25, 783.99, 1046.5]);
          showToast("39 // Concert Overdrive: ON");
        } else {
          playChime([783.99, 523.25]);
          showToast("01 // Concert Overdrive: OFF");
        }
      }

      // 3. Homepage Miku tag -> Cycle status text
      const mikuTag = target.closest("#miku-tag");
      if (mikuTag) {
        tagIdx = (tagIdx + 1) % tagStates.length;
        mikuTag.textContent = tagStates[tagIdx];
        mikuTag.classList.remove("pop");
        void mikuTag.offsetWidth;
        mikuTag.classList.add("pop");
      }

      // 4. Spawn Material ripple AFTER text updates so it stays visible
      const rippleHost = target.closest(rippleTargets);
      if (rippleHost) spawnRipple(rippleHost, e);
    };

    let buffer = "";
    const onKeydown = (e) => {
      const tag = (e.target && e.target.tagName) || "";
      if (tag === "INPUT" || tag === "TEXTAREA" || e.target?.isContentEditable) return;
      if (e.key.length !== 1) return;

      buffer = (buffer + e.key.toLowerCase()).slice(-4);
      if (buffer.endsWith("miku") || buffer.endsWith("39")) {
        buffer = "";
        spawnLeekRain();
        playChime([659.25, 783.99, 987.77]);
        showToast("39! Miku is hiding in your Wi-Fi ♪");
      }
    };

    document.addEventListener("click", onClick);
    document.addEventListener("keydown", onKeydown);
    document.addEventListener("astro:after-swap", syncBadgeText);

    window.__mikuCleanup = () => {
      media.removeEventListener("change", onMediaChange);
      document.removeEventListener("click", onClick);
      document.removeEventListener("keydown", onKeydown);
      document.removeEventListener("astro:after-swap", syncBadgeText);
    };
  })();
</script>

<style>
  .m3-header-wrap {
    position: sticky;
    top: 12px;
    z-index: 50;
    padding: 0 1rem;
    margin-top: 12px;
  }

  .m3-topbar {
    max-width: 900px;
    margin: 0 auto;
    padding: 0.5rem 0.75rem 0.5rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--md-surface-low) 82%, transparent);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid var(--md-outline-variant);
    box-shadow: var(--md-shadow-1);
    transition: box-shadow 0.3s var(--md-ease), border-color 0.3s var(--md-ease);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .brand-name {
    color: var(--md-on-surface);
    font-weight: 800;
    font-size: 0.98rem;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .brand-name:hover {
    color: var(--md-primary);
  }

  .brand-pill {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
    border: none;
    background: var(--md-primary-container);
    color: var(--md-on-primary-container);
    cursor: pointer;
    user-select: none;
    transition: transform 0.25s var(--md-ease-spring), background-color 0.2s var(--md-ease);
  }

  .brand-pill:hover {
    transform: scale(1.1);
  }

  .brand-pill:active {
    transform: scale(0.92);
  }

  .nav-pills {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-pills :global(a) {
    position: relative;
    overflow: hidden;
    padding: 0.45rem 1rem;
    border-radius: 9999px;
    color: var(--md-on-surface-variant);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 0.25s var(--md-ease),
      color 0.25s var(--md-ease),
      transform 0.25s var(--md-ease-spring);
  }

  .nav-pills :global(a:hover) {
    background: var(--md-surface-container);
    color: var(--md-on-surface);
    transform: translateY(-1px);
  }

  .nav-pills :global(a:active) {
    transform: scale(0.95);
  }

  .nav-pills :global(a.active) {
    background: var(--md-primary-container);
    color: var(--md-on-primary-container);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    border: none;
    background: var(--md-surface-container);
    color: var(--md-on-surface);
    cursor: pointer;
    text-decoration: none;
    transition:
      background-color 0.25s var(--md-ease),
      color 0.25s var(--md-ease),
      transform 0.28s var(--md-ease-spring);
  }

  .icon-btn:hover {
    background: var(--md-primary-container);
    color: var(--md-on-primary-container);
    transform: scale(1.1);
  }

  .icon-btn:active {
    transform: scale(0.92);
  }

  .icon-sun {
    display: none;
  }
  .icon-moon {
    display: block;
  }

  :global(html[data-theme="dark"]) .icon-sun {
    display: block;
  }
  :global(html[data-theme="dark"]) .icon-moon {
    display: none;
  }

  /* Concert Overdrive Mode */
  :global(html.miku-overdrive .m3-topbar),
  :global(html.miku-overdrive .m3-card),
  :global(html.miku-overdrive .post-card) {
    border-color: var(--md-primary);
    box-shadow:
      0 0 24px rgba(57, 197, 187, 0.28),
      0 0 48px rgba(255, 107, 168, 0.14);
  }

  :global(html.miku-overdrive .brand-pill) {
    background: var(--md-tertiary);
    color: #ffffff;
  }

  /* Material 3 Snackbar Toast */
  :global(.miku-toast) {
    position: fixed;
    left: 50%;
    bottom: 24px;
    transform: translate(-50%, 16px) scale(0.95);
    opacity: 0;
    pointer-events: none;
    z-index: 100;
    padding: 0.7rem 1.35rem;
    border-radius: 9999px;
    background: var(--md-surface-high);
    color: var(--md-on-surface);
    border: 1px solid var(--md-primary);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.85rem;
    font-weight: 700;
    transition: opacity 0.25s var(--md-ease), transform 0.3s var(--md-ease-spring);
  }

  :global(.miku-toast.visible) {
    opacity: 1;
    transform: translate(-50%, 0) scale(1);
  }

  /* Floating Leek & 39 Rain */
  :global(.miku-particle) {
    position: fixed;
    top: -40px;
    z-index: 90;
    pointer-events: none;
    user-select: none;
    font-family: "JetBrains Mono", monospace;
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--md-primary);
    filter: drop-shadow(0 2px 6px rgba(57, 197, 187, 0.35));
    animation-name: miku-fall;
    animation-timing-function: linear;
    animation-fill-mode: forwards;
  }

  :global(.miku-particle:nth-child(even)) {
    color: var(--md-tertiary);
  }

  @keyframes miku-fall {
    0% {
      transform: translateY(0) rotate(0deg);
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      transform: translateY(105vh) rotate(360deg);
      opacity: 0;
    }
  }

  @media (max-width: 680px) {
    .brand-name {
      display: none;
    }
    .nav-pills :global(a) {
      padding: 0.4rem 0.75rem;
      font-size: 0.85rem;
    }
  }
</style>
