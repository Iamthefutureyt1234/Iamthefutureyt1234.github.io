---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="m3-card hero">
        <button
          id="miku-tag"
          type="button"
          class="m3-chip"
          dir="ltr"
          title="Click me"
        >
          01 // MIKU EDITION
        </button>

        <h1 class="hero-title">HELLLLLLOOO Stranger</h1>
        <p class="hero-lead">
          Yooo, so this is my personal blog where I write semi-technical posts about tech.
        </p>

        <div class="cta-row">
          <a href="/blog" class="m3-btn m3-btn-filled">The Good Stuff</a>
          <a
            href="https://t.me/PlaceOfTHEfuture"
            target="_blank"
            rel="noopener noreferrer"
            class="m3-btn m3-btn-tonal"
          >
            My Telegram Channel
          </a>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>


<style>
  .hero {
    margin-top: 1.5rem;
    position: relative;
    overflow: hidden;
  }

  .m3-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.15rem;
    padding: 0.35rem 0.95rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--md-tertiary) 35%, transparent);
    background: var(--md-tertiary-container);
    color: var(--md-on-tertiary-container);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    cursor: pointer;
    user-select: none;
    transition: transform 0.2s var(--md-ease), box-shadow 0.2s var(--md-ease);
  }

  .m3-chip:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(255, 107, 168, 0.22);
  }

  .m3-chip.pop {
    animation: chip-pop 0.28s var(--md-ease);
  }

  @keyframes chip-pop {
    0% { transform: scale(0.92); }
    60% { transform: scale(1.06); }
    100% { transform: scale(1); }
  }

  .hero-title {
    margin-bottom: 1rem;
    background: linear-gradient(135deg, var(--md-primary), var(--md-tertiary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-lead {
    max-width: 560px;
    margin: 0 auto 2rem;
    font-size: 1.1rem;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
  }
</style>
