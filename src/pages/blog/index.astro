---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="blog-feed">
        <div class="feed-grid">
          {
            posts.map((post, index) => (
              <a
                href={`/blog/${post.id}/`}
                class={`post-card ${index === 0 ? "featured" : ""}`}
                style={`--delay: ${Math.min(index * 65, 450)}ms;`}
              >
                {post.data.heroImage && (
                  <div class="thumb-wrap">
                    {typeof post.data.heroImage === "string" ? (
                      <img src={post.data.heroImage} alt={post.data.title} />
                    ) : (
                      <Image
                        width={720}
                        height={360}
                        src={post.data.heroImage}
                        alt={post.data.title}
                      />
                    )}
                  </div>
                )}

                <div class="post-meta">
                  <span class="date-chip">
                    <FormattedDate date={post.data.pubDate} />
                  </span>
                  <h2 class="post-title">{post.data.title}</h2>
                  {post.data.description && (
                    <p class="post-desc">{post.data.description}</p>
                  )}
                </div>
              </a>
            ))
          }
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .feed-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.35rem;
    margin-top: 0.75rem;
  }

  .post-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: var(--md-surface-low);
    border: 1px solid var(--md-outline-variant);
    border-radius: 26px;
    text-decoration: none;
    box-shadow: var(--md-shadow-1);
    animation: m3-rise 0.55s var(--md-ease-emphasized) var(--delay, 0ms) both;
    transition:
      transform 0.35s var(--md-ease-spring),
      box-shadow 0.35s var(--md-ease-emphasized),
      border-color 0.25s var(--md-ease),
      background-color 0.25s var(--md-ease);
  }

  .post-card.featured {
    grid-column: 1 / -1;
  }

  .post-card:hover {
    transform: translateY(-6px);
    border-color: var(--md-primary);
    background: var(--md-surface-container);
    box-shadow: var(--md-shadow-2);
  }

  .post-card:active {
    transform: translateY(-2px) scale(0.985);
  }

  .thumb-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--md-surface-container);
  }

  .post-card.featured .thumb-wrap {
    aspect-ratio: 21 / 9;
  }

  .thumb-wrap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    box-shadow: none;
    transition: transform 0.55s var(--md-ease-emphasized);
  }

  .post-card:hover .thumb-wrap :global(img) {
    transform: scale(1.06);
  }

  .post-meta {
    padding: 1.5rem 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
  }

  .date-chip {
    display: inline-block;
    padding: 0.2rem 0.75rem;
    border-radius: 9999px;
    background: var(--md-primary-container);
    color: var(--md-on-primary-container);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .post-title {
    margin: 0.2rem 0 0;
    font-size: 1.35rem;
    color: var(--md-on-surface);
    transition: color 0.25s var(--md-ease);
  }

  .post-card.featured .post-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .post-card:hover .post-title {
    color: var(--md-primary);
  }

  .post-desc {
    margin: 0;
    font-size: 0.95rem;
    color: var(--md-on-surface-variant);
    max-width: 580px;
  }

  @media (max-width: 720px) {
    .feed-grid {
      grid-template-columns: 1fr;
    }
    .post-card.featured .thumb-wrap {
      aspect-ratio: 16 / 9;
    }
  }
</style>
